{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vokabel-studio-import-1",
  "title": "Vokabel-Studio Import v1",
  "description": "Antwort des Chatbots (ChatGPT/Gemini) auf ein Foto einer Vokabelseite. Unbekannte Zusatzfelder werden von der App ignoriert und als Warnung gemeldet.",
  "type": "object",
  "required": ["schema", "inhaltstyp", "fach", "lehrwerk", "unit", "parts"],
  "properties": {
    "schema": { "const": "vokabel-studio-import/1" },
    "inhaltstyp": {
      "enum": ["vokabelliste", "lueckentext", "arbeitsblatt", "handliste"],
      "description": "v1 verarbeitet nur 'vokabelliste'. Die übrigen Werte sind für spätere Versionen reserviert."
    },
    "fach": {
      "type": "string",
      "pattern": "^[a-z]+$",
      "description": "Fach-Code, v1 bekannt: 'englisch', 'latein'."
    },
    "lehrwerk": {
      "type": "object",
      "required": ["titel", "band"],
      "properties": {
        "titel": { "type": "string", "minLength": 1 },
        "band": { "type": "string" },
        "ausgabe": { "type": "string" }
      }
    },
    "unit": {
      "type": "object",
      "required": ["nummer"],
      "properties": {
        "nummer": { "type": "string", "minLength": 1 },
        "titel": { "type": "string" }
      }
    },
    "seiten": { "type": "array", "items": { "type": "string" } },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/part" }
    },
    "lernsaetze": {
      "type": "array",
      "items": { "$ref": "#/$defs/lernsatz" }
    },
    "satzbau": {
      "type": "array",
      "items": { "$ref": "#/$defs/satzbau" }
    },
    "hinweise": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Was der Chatbot nicht lesen konnte oder unsicher war."
    }
  },
  "$defs": {
    "textliste": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "part": {
      "type": "object",
      "required": ["kennung", "vokabeln"],
      "properties": {
        "kennung": { "type": "string", "minLength": 1 },
        "titel": { "type": "string" },
        "vokabeln": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vokabel" } }
      }
    },
    "vokabel": {
      "type": "object",
      "required": ["wort", "wortart", "bedeutungen"],
      "properties": {
        "wort": { "type": "string", "minLength": 1 },
        "lautschrift": { "type": "string" },
        "wortart": {
          "enum": ["nomen", "verb", "adjektiv", "adverb", "praeposition", "konjunktion", "pronomen", "zahlwort", "interjektion", "wendung", "sonstiges"]
        },
        "bedeutungen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "formen": { "$ref": "#/$defs/formen" },
        "erklaerung": { "type": "string", "description": "Umschreibung in der Fremdsprache aus dem Buch, z. B. 'someone who plays an instrument'." },
        "andere_sprachen": {
          "type": "array",
          "description": "Verweise auf verwandte Wörter anderer Sprachen aus dem Buch (F = französisch, L = lateinisch).",
          "items": {
            "type": "object",
            "required": ["sprache", "wort"],
            "properties": {
              "sprache": { "enum": ["fr", "la", "en", "es", "it", "de"] },
              "wort": { "type": "string", "minLength": 1 },
              "bedeutung": { "type": "string" }
            }
          }
        },
        "beispiele": { "type": "array", "items": { "$ref": "#/$defs/beispiel" } },
        "gegenteile": { "$ref": "#/$defs/textliste" },
        "synonyme": { "$ref": "#/$defs/textliste" },
        "wortfamilie": { "$ref": "#/$defs/textliste" },
        "stolpersteine": { "$ref": "#/$defs/textliste" },
        "merkhilfe": { "type": "string" },
        "unsicher": { "type": "boolean" },
        "unsicher_grund": { "type": "string" }
      }
    },
    "formen": {
      "type": "object",
      "properties": {
        "plural": { "type": "string" },
        "simple_past": { "type": "string" },
        "past_participle": { "type": "string" },
        "steigerung": { "type": "string" },
        "genitiv": { "type": "string" },
        "genus": { "enum": ["m", "f", "n", "m/f"] },
        "deklination": { "enum": ["a", "o", "kons", "e", "u", "i", "gemischt"] },
        "adjektiv_endungen": { "type": "string" },
        "stammformen": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string" } },
        "konjugation": { "enum": ["a", "e", "i", "kons", "kons-i", "unregelmaessig"] },
        "rektion": { "type": "string" }
      }
    },
    "beispiel": {
      "type": "object",
      "required": ["fremd", "deutsch", "quelle"],
      "properties": {
        "fremd": { "type": "string", "minLength": 1 },
        "deutsch": { "type": "string", "minLength": 1 },
        "quelle": { "enum": ["buch", "ki"] }
      }
    },
    "lernsatz": {
      "type": "object",
      "required": ["fremd", "deutsch", "woerter"],
      "properties": {
        "fremd": { "type": "string", "minLength": 1 },
        "deutsch": { "type": "string", "minLength": 1 },
        "woerter": { "$ref": "#/$defs/textliste" },
        "part": { "type": "string" }
      }
    },
    "satzbau": {
      "type": "object",
      "required": ["deutsch", "loesung"],
      "properties": {
        "deutsch": { "type": "string", "minLength": 1 },
        "loesung": { "type": "string", "minLength": 1 },
        "alternativen": { "$ref": "#/$defs/textliste" },
        "ablenker": { "$ref": "#/$defs/textliste" },
        "woerter": { "$ref": "#/$defs/textliste" },
        "part": { "type": "string" }
      }
    }
  }
}
